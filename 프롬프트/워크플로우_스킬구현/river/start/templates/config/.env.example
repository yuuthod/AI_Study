# 복사: cp .env.example .env  (실제 .env는 절대 커밋 금지 — .gitignore에 포함)
# env.server.ts가 부팅 시 Zod로 검증한다. 누락/오타면 즉시 멈춘다.

# 로컬 Docker 사용 시 기본값. 외부 Postgres면 그 연결문자열로 교체.
DATABASE_URL="postgresql://app:app@localhost:5432/app?schema=public"

# 세션 쿠키 서명 시크릿 — 32자 이상 무작위. openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

NODE_ENV="development"
